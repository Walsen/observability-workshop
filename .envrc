#!/usr/bin/env bash

# Automatically sets up your devbox environment whenever you cd into this
# directory via our direnv integration:

eval "$(devbox generate direnv --print-envrc)"

# check out https://www.jetify.com/docs/devbox/ide_configuration/direnv/
# for more details
# Load non-sensitive local development configuration if present.
# Secrets must live in a git-ignored .env.local or the platform secret store,
# never in a committed file.
dotenv_if_exists .env.development
