# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
# ...but keep ONLY the xray-layer asset's directory skeleton tracked (the
# .keep), not the wheels `just build-layer` installs into it. `SudokuStack`
# references build/xray-layer as a Lambda layer asset, and `cdk synth` (plus the
# offline template-assertion suite) stages that local directory at synth time —
# it only needs the directory to EXIST, not the wheels. Tracking the .keep keeps
# synth offline on a fresh checkout / clean CI runner; the installed wheels stay
# ignored (they are a deploy-time artifact). The rules un-ignore the directory
# chain for traversal, then keep the directory's CONTENTS ignored, then
# re-include the single .keep.
!build/
!build/xray-layer/
!build/xray-layer/python/
build/xray-layer/python/*
!build/xray-layer/python/.keep
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

