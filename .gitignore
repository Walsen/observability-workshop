# Devbox
.devbox/

# Devbox / uv managed environment (reproducible dev environment task 1.1)
# .devbox/ is already ignored above; ensure the uv-managed virtualenv dir and
# any local secrets / generated credential tree are never committed.
.venv/

# Local, git-ignored secrets file (non-sensitive config goes in .env.development,
# which .envrc loads; real secrets live here or in the platform secret store).
.env.local

# Generated credential tree (e.g. locally-generated AWS credentials/config).
.aws/

# CDK synth output. `cdk synth` / `just synth` writes the synthesized
# CloudFormation template and assets here; it is a generated artifact, never
# committed. The offline template assertions (task 10.6) synthesize on demand.
cdk.out/

# CDK deploy outputs file (`cdk deploy --outputs-file`). A generated artifact of
# a live deploy that captures the ApiEndpointUrl; never committed.
cdk-deploy-outputs.json
